# ============================================
# TableMaster Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# PostgreSQL
POSTGRES_DB=tablemaster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Redis
REDIS_PASSWORD=your_redis_password_here

# RabbitMQ
RABBITMQ_USER=tablemaster
RABBITMQ_PASS=your_rabbitmq_password_here

# JWT & Security (REQUIRED: Must be at least 256 bits / 32 characters)
JWT_SECRET=your-256-bit-secret-key-must-be-at-least-32-characters-long
DEVICE_APP_SECRET=your-device-app-secret-key-change-in-production
